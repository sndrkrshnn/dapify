# Left capacitive key (Linux 139): deliberately unmapped. The old APP_SWITCH
# action is removed completely, so the button now does nothing.
# key 139    APP_SWITCH	VIRTUAL
# Center capacitive key (Linux 172): play/pause through the active media
# session instead of HOME. The player is the HOME app, so this is its primary
# transport control.
key 172    MEDIA_PLAY_PAUSE	VIRTUAL
key 158    BACK		VIRTUAL
key 217    SEARCH	VIRTUAL
